# Copy to .env (git-ignored). Read by the Taskfile in k8s/.
# Needed for real LLM calls; the cluster itself comes up without them.
OPENAI_KEY=
GEMINI_KEY=

# Optional: the client key for the LLM gateway (default: sk-ai-lab-gateway). Agents, examples and evals send it; the
# gateway swaps in the provider's own key upstream, so the keys above never leave the gateway.
# LLM_GATEWAY_KEY=

# --- Local inference (optional): vLLM-Metal on the Mac host, served through the gateway's /llm/local route ---
# Install once: `cd k8s && task inference:install`. Run: `task inference:run` (blocking terminal).
VLLM_API_KEY=GENERATE_ME            # any string; e.g. `openssl rand -hex 16`
VLLM_MODEL=mlx-community/Mistral-7B-Instruct-v0.3-4bit
VLLM_PORT=8000
# Bind to all interfaces so the kind cluster can reach the host (the default is 127.0.0.1, host only).
# VLLM_BIND_HOST=0.0.0.0
# Chat template and tool-call parser are model-specific (see inference/inference.sh):
# VLLM_CHAT_TEMPLATE=llm/mistral-chat-template.jinja
# VLLM_TOOL_PARSER=mistral
# Standalone examples talk to vLLM directly:
# VLLM_BASE_URL=http://127.0.0.1:8000/v1

# --- Traces for the standalone examples (agentic-examples/). Unset = no tracing. ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://grafana.lab:4318
